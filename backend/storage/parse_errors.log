{"action": "type", "target": "[data-agent-id=\"10\"]", "value": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>FoodMania - Better than FoodHub</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        }\n\n        body {\n            background: linear-gradient(135deg, #ff6b6b, #feca57, #ff9ff3);\n            background-size: 300% 300%;\n            animation: gradientBG 15s ease infinite;\n            min-height: 100vh;\n            color: #333;\n        }\n\n        @keyframes gradientBG {\n            0% { background-position: 0% 50%; }\n            50% { background-position: 100% 50%; }\n            100% { background-position: 0% 50%; }\n        }\n\n        header {\n            background: rgba(255, 255, 255, 0.15);\n            backdrop-filter: blur(10px);\n            padding: 1.5rem 2rem;\n            position: sticky;\n            top: 0;\n            z-index: 100;\n            border-bottom: 2px solid rgba(255, 255, 255, 0.3);\n        }\n\n        nav {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            flex-wrap: wrap;\n            gap: 1rem;\n        }\n\n        .logo {\n            font-size: 2rem;\n            font-weight: 900;\n            color: #fff;\n            text-decoration: none;\n            letter-spacing: -1px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n        }\n\n        .logo span {\n            color: #ffeb3b;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-links a {\n            color: #fff;\n            text-decoration: none;\n            font-weight: 600;\n            font-size: 1rem;\n            transition: all 0.3s;\n            padding: 0.5rem 1rem;\n            border-radius: 25px;\n        }\n\n        .nav-links a:hover {\n            background: rgba(255, 255, 255, 0.2);\n            transform: translateY(-2px);\n        }\n\n        .hero {\n            text-align: center;\n            padding: 100px 20px 60px;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .hero h1 {\n            font-size: 4.5rem;\n            color: #fff;\n            margin-bottom: 1rem;\n            text-shadow: 3px 3px 8px rgba(0,0,0,0.4);\n            animation: fadeInDown 1s ease;\n        }\n\n        .hero .tagline {\n            font-size: 1.8rem;\n            color: #ffeb3b;\n            font-weight: 700;\n            margin-bottom: 2rem;\n            text-shadow: 2px 2px 6px rgba(0,0,0,0.4);\n            animation: fadeInUp 1s ease;\n        }\n\n        .cta-button {\n            background: #ff4757;\n            color: white;\n            border: none;\n            padding: 1.2rem 2.5rem;\n            font-size: 1.2rem;\n            font-weight: 700;\n            border-radius: 50px;\n            cursor: pointer;\n            transition: all 0.3s;\n            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);\n            animation: fadeInUp 1.2s ease;\n        }\n\n        .cta-button:hover {\n            background: #ff6b81;\n            transform: scale(1.05);\n            box-shadow: 0 6px 20px rgba(255, 71, 87, 0.6);\n        }\n\n        @keyframes fadeInDown {\n            from { opacity: 0; transform: translateY(-30px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        @keyframes fadeInUp {\n            from { opacity: 0; transform: translateY(30px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        .section-title {\n            text-align: center;\n            font-size: 2.5rem;\n            color: #fff;\n            margin: 3rem 0 2rem;\n            text-shadow: 2px 2px 6px rgba(0,0,0,0.3);\n        }\n\n        .menu-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto 4rem;\n            padding: 0 20px;\n        }\n\n        .menu-card {\n            background: rgba(255, 255, 255, 0.9);\n            border-radius: 20px;\n            overflow: hidden;\n            transition: all 0.4s;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.1);\n        }\n\n        .menu-card:hover {\n            transform: translateY(-10px);\n            box-shadow: 0 20px 40px rgba(0,0,0,0.2);\n        }\n\n        .menu-card img {\n            width: 100%;\n            height: 200px;\n            object-fit: cover;\n        }\n\n        .menu-card h3 {\n            padding: 1.5rem 1.5rem 0.5rem;\n            color: #2d3436;\n            font-size: 1.5rem;\n        }\n\n        .menu-card p {\n            padding: 0 1.5rem 1rem;\n            color: #636e72;\n            font-size: 1rem;\n        }\n\n        .menu-card .price {\n            display: block;\n            padding: 0 1.5rem 1.5rem;\n            font-weight: 800;\n            color: #ff4757;\n            font-size: 1.3rem;\n        }\n\n        .about {\n            background: rgba(255, 255, 255, 0.9);\n            padding: 4rem 20px;\n            max-width: 1000px;\n            margin: 0 auto;\n            border-radius: 30px;\n            margin-bottom: 4rem;\n        }\n\n        .about-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 3rem;\n            align-items: center;\n        }\n\n        .about h2 {\n            font-size: 2.5rem;\n            color: #2d3436;\n            margin-bottom: 1rem;\n        }\n\n        .about p {\n            font-size: 1.1rem;\n            line-height: 1.8;\n            color: #636e72;\n        }\n\n        .stats {\n            display: flex;\n            gap: 2rem;\n            margin-top: 2rem;\n        }\n\n        .stat-item {\n            text-align: center;\n        }\n\n        .stat-item h3 {\n            font-size: 2rem;\n            color: #ff4757;\n        }\n\n        .stat-item p {\n            color: #636e72;\n            font-weight: 600;\n        }\n\n        footer {\n            background: rgba(0, 0, 0, 0.6);\n            color: #fff;\n            text-align: center;\n            padding: 3rem 20px;\n            border-top: 2px solid rgba(255, 255, 255, 0.2);\n        }\n\n        .footer-content {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .footer-content h3 {\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            color: #ffeb3b;\n        }\n\n        .footer-content p {\n            opacity: 0.8;\n            font-size: 1rem;\n        }\n\n        .socials {\n            margin-top: 1.5rem;\n            display: flex;\n            justify-content: center;\n            gap: 1rem;\n        }\n\n        .socials a {\n            color: #fff;\n            font-size: 1.5rem;\n            transition: all 0.3s;\n        }\n\n        .socials a:hover {\n            color: #ff4757;\n            transform: scale(1.2);\n        }\n\n        @media (max-width: 768px) {\n            .hero h1 { font-size: 3rem; }\n            .hero .tagline { font-size: 1.3rem; }\n            .nav-links { gap: 1rem; }\n            .nav-links a { font-size: 0.9rem; padding: 0.4rem 0.8rem; }\n        }\n    </style>\n</head>\n<body>\n\n    <header>\n        <nav>\n            <a href=\"#\" class=\"logo\">Food<span>Mania</span></a>\n            <ul class=\"nav-links\">\n                <li><a href=\"#home\">Home</a></li>\n                <li><a href=\"#menu\">Menu</a></li>\n                <li><a href=\"#about\">About</a></li>\n                <li><a href=\"#contact\">Contact</a></li>\n            </ul>\n        </nav>\n    </header>\n\n    <section class=\"hero\" id=\"home\">\n        <h1>FoodMania</h1>\n        <div class=\"tagline\">Better than FoodHub</div>\n        <button class=\"cta-button\">Order Now</button>\n    </section>\n\n    <section class=\"menu\" id=\"menu\">\n        <h2 class=\"section-title\">Our Delicious Menu</h2>\n        <div class=\"menu-grid\">\n            <div class=\"menu-card\">\n                <img src=\"https://via.placeholder.com/300x200/ff6b6b/ffffff?text=Burger\" alt=\"Signature Burger\">\n                <h3>Signature Burger</h3>\n                <p>Juicy beef patty with fresh lettuce, tomato, and our special sauce.</p>\n                <span class=\"price\">$12.99</span>\n            </div>\n            <div class=\"menu-card\">\n                <img src=\"https://via.placeholder.com/300x200/feca57/ffffff?text=Pizza\" alt=\"Margherita Pizza\">\n                <h3>Margherita Pizza</h3>\n                <p>Classic Italian pizza with mozzarella, basil, and tomato sauce.</p>\n                <span class=\"price\">$14.99</span>\n            </div>\n            <div class=\"menu-card\">\n                <img src=\"https://via.placeholder.com/300x200/ff9ff3/ffffff?text=Pasta\" alt=\"Creamy Pasta\">\n                <h3>Creamy Pasta</h3>\n                <p>Fettuccine in rich Alfredo sauce with grilled chicken and parmesan.</p>\n                <span class=\"price\">$11.99</span>\n            </div>\n            <div class=\"menu-card\">\n                <img src=\"https://via.placeholder.com/300x200/2ed573/ffffff?text=Salad\" alt=\"Fresh Salad\">\n                <h3>Fresh Garden Salad</h3>\n                <p>Crisp mixed greens with cherry tomatoes, cucumber, and balsamic vinaigrette.</p>\n                <span class=\"price\">$8.99</span>\n            </div>\n            <div class=\"menu-card\">\n                <img src=\"https://via.placeholder.com/300x200/54a0ff/ffffff?text=Sushi\" alt=\"Sushi Platter\">\n                <h3>Sushi Platter</h3>\n                <p>Assorted fresh sushi rolls with salmon, tuna, and avocado.</p>\n                <span class=\"price\">$18.99</span>\n            </div>\n            <div class=\"menu-card\">\n                <img src=\"https://via.placeholder.com/300x200/ff9ff3/ffffff?text=Cake\" alt=\"Chocolate Cake\">\n                <h3>Chocolate Lava Cake</h3>\n                <p>Warm chocolate cake with molten center served with vanilla ice cream.</p>\n                <span class=\"price\">$7.99</span>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"about\" id=\"about\">\n        <div class=\"about-content\">\n            <div>\n                <h2>Why FoodMania?</h2>\n                <p>At FoodMania, we believe great food brings people together. Our chefs use only the freshest ingredients to create unforgettable flavors that keep you coming back for more.</p>\n                <p>We're not just another food delivery service - we're a culinary experience designed to delight your taste buds.</p>\n                <div class=\"stats\">\n                    <div class=\"stat-item\">\n                        <h3>500+</h3>\n                        <p>Dishes</p>\n                    </div>\n                    <div class=\"stat-item\">\n                        <h3>50+</h3>\n                        <p>Cities</p>\n                    </div>\n                    <div class=\"stat-item\">\n                        <h3>24/7</h3>\n                        <p>Service</p>\n                    </div>\n                </div>\n            </div>\n            <div>\n                <img src=\"https://via.placeholder.com/400x300/ff6b6b/ffffff?text=FoodMania+Kitchen\" alt=\"FoodMania Kitchen\" style=\"width:100%; border-radius:20px; box-shadow:0 10px 30px rgba(0,0,0,0.2);\">\n            </div>\n        </div>\n    </section>\n\n    <footer id=\"contact\">\n        <div class=\"footer-content\">\n            <h3>FoodMania</h3>\n            <p>Better than FoodHub - Always fresh, always delicious.</p>\n            <div class=\"socials\">\n                <a href=\"#\">&#xf09a;</a>\n                <a href=\"#\">&#xf099;</a>\n                <a href=\"#\">&#xf09a;</a>\n                <a href=\"#\">&#xf16d;</a>\n            </div>\n            <p style=\"margin-top:1.5rem; font-size:0.9rem; opacity:0.6;\">&#169; 2024 FoodMania. All rights reserved.</p>\n        </div>\n    </footer>\n\n</body>\n</html>"}

