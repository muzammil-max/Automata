{"action": "type", "target": "[data-agent-id=\"9\"]", "value": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>FoodMania - Better than Foodhub</title>\n    <meta name=\"description\" content=\"Premium food delivery service. Order amazing food from your favorite restaurants.\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n</head>\n<body>\n\n    <!-- Navigation -->\n    <nav class=\"navbar\" id=\"navbar\">\n        <div class=\"nav-container\">\n            <div class=\"nav-logo\">\n                <div class=\"logo-icon\">FM</div>\n                <span>FoodMania</span>\n            </div>\n\n            <ul class=\"nav-links\">\n                <li><a href=\"#home\" class=\"nav-link active\">Home</a></li>\n                <li><a href=\"#explore\" class=\"nav-link\">Explore Restaurants</a></li>\n                <li><a href=\"#categories\" class=\"nav-link\">Categories</a></li>\n                <li><a href=\"#offers\" class=\"nav-link\">Offers & Deals</a></li>\n                <li><a href=\"#about\" class=\"nav-link\">About Us</a></li>\n            </ul>\n\n            <div class=\"nav-search\">\n                <form id=\"headerSearchForm\">\n                    <i class=\"fa-solid fa-magnifying-glass\"></i>\n                    <input type=\"text\" placeholder=\"Search restaurants, dishes, or cuisines...\" class=\"header-search-input\">\n                    <button type=\"submit\" class=\"header-search-btn\">Go</button>\n                </form>\n            </div>\n\n            <div class=\"nav-actions\">\n                <div class=\"location-selector\" id=\"locationSelector\">\n                    <i class=\"fa-solid fa-location-dot\"></i>\n                    <span>Deliver to <span id=\"locationDisplay\">Karachi</span></span>\n                    <i class=\"fa-solid fa-chevron-down\"></i>\n                </div>\n                <div class=\"cart-icon\" id=\"cartIcon\" onclick=\"toggleCart()\">\n                    <i class=\"fa-solid fa-cart-shopping\"></i>\n                    <span class=\"cart-count\" id=\"cartCount\">0</span>\n                </div>\n                <button class=\"btn-login\" onclick=\"openAuthModal()\">Login / Sign Up</button>\n            </div>\n\n            <button class=\"mobile-menu-btn\" id=\"mobileMenuBtn\" onclick=\"toggleMobileMenu()\">\n                <i class=\"fa-solid fa-bars\"></i>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Mobile Menu -->\n    <div class=\"mobile-menu\" id=\"mobileMenu\">\n        <div class=\"mobile-menu-header\">\n            <div class=\"nav-logo\">\n                <div class=\"logo-icon\">FM</div>\n                <span>FoodMania</span>\n            </div>\n            <button class=\"close-mobile-menu\" onclick=\"toggleMobileMenu()\">\n                <i class=\"fa-solid fa-times\"></i>\n            </button>\n        </div>\n        <ul class=\"mobile-nav-links\">\n            <li><a href=\"#home\">Home</a></li>\n            <li><a href=\"#explore\">Explore Restaurants</a></li>\n            <li><a href=\"#categories\">Categories</a></li>\n            <li><a href=\"#offers\">Offers & Deals</a></li>\n            <li><a href=\"#about\">About Us</a></li>\n        </ul>\n        <div class=\"mobile-actions\">\n            <button onclick=\"openAuthModal()\">Login / Sign Up</button>\n        </div>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-bg\"></div>\n        <div class=\"hero-overlay\"></div>\n        <div class=\"hero-content\">\n            <div class=\"hero-badge\">\n                <i class=\"fa-solid fa-fire\"></i>\n                <span>Better than Foodhub</span>\n            </div>\n            <h1>Cravings? We've Got You Covered!</h1>\n            <p>Discover amazing restaurants, explore delicious meals, and get your favorite food delivered straight to your doorstep.</p>\n\n            <div class=\"hero-search\">\n                <form id=\"heroSearchForm\" onsubmit=\"event.preventDefault(); searchFood();\">\n                    <div class=\"search-row\">\n                        <input type=\"text\" class=\"hero-search-input\" placeholder=\"Search for restaurants, dishes, or cuisines...\" id=\"heroSearchInput\">\n                        <div class=\"hero-location\">\n                            <i class=\"fa-solid fa-location-dot\"></i>\n                            <input type=\"text\" class=\"hero-location-input\" value=\"Karachi\" id=\"heroLocationInput\" readonly>\n                            <i class=\"fa-solid fa-chevron-down\"></i>\n                        </div>\n                        <button type=\"submit\" class=\"hero-search-btn\">Explore Food</button>\n                    </div>\n                </form>\n            </div>\n\n            <div class=\"hero-promos\">\n                <div class=\"promo-item\">\n                    <span>🎁 30% OFF First Order</span>\n                </div>\n                <div class=\"promo-item\">\n                    <span>⚡ Delivery in 30 Mins</span>\n                </div>\n                <div class=\"promo-item\">\n                    <span>🚚 Free Delivery Above Rs.999</span>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"hero-visual\">\n            <div class=\"food-card large\">\n                <div class=\"food-badge\">Popular</div>\n                <img src=\"https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600&h=500&fit=crop\" alt=\"Zinger Burger\" class=\"food-img\">\n                <div class=\"food-overlay\">\n                    <h3>Crispy Zinger Burger</h3>\n                    <p>Rs. 1,499</p>\n                </div>\n            </div>\n            <div class=\"food-card small top-left\">\n                <img src=\"https://images.unsplash.com/photo-1571091718767-18b5b1457add?w=300&h=300&fit=crop\" alt=\"Pizza\" class=\"food-img\">\n                <div class=\"food-overlay\">\n                    <h3>Margherita Pizza</h3>\n                    <p>Rs. 2,199</p>\n                </div>\n            </div>\n            <div class=\"food-card small bottom-right\">\n                <img src=\"https://images.unsplash.com/photo-1603894574374-65422f991cf1?w=300&h=300&fit=crop\" alt=\"Biryani\" class=\"food-img\">\n                <div class=\"food-overlay\">\n                    <h3>Chicken Biryani</h3>\n                    <p>Rs. 1,899</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Categories -->\n    <section class=\"categories\" id=\"categories\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <h2>Explore by Category</h2>\n                <p>Find exactly what you're craving</p>\n                <a href=\"#explore\" class=\"view-all\">View All Categories <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n            <div class=\"categories-grid\" id=\"categoriesGrid\">\n                <!-- Populated by JS -->\n            </div>\n        </div>\n    </section>\n\n    <!-- Featured Restaurants -->\n    <section class=\"restaurants\" id=\"explore\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <h2>Featured Restaurants</h2>\n                <p>Popular spots near you</p>\n                <a href=\"#explore\" class=\"view-all\">View All Restaurants <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n            <div class=\"restaurants-grid\" id=\"restaurantsGrid\">\n                <!-- Populated by JS -->\n            </div>\n        </div>\n    </section>\n\n    <!-- Popular Dishes -->\n    <section class=\"dishes\" id=\"dishes\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <h2>Popular Dishes</h2>\n                <p>Customer favorites</p>\n                <a href=\"#dishes\" class=\"view-all\">View All Dishes <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n\n            <div class=\"dish-filters\">\n                <button class=\"filter-btn active\" onclick=\"filterDishes('all')\">All</button>\n                <button class=\"filter-btn\" onclick=\"filterDishes('Burgers')\">Burgers</button>\n                <button class=\"filter-btn\" onclick=\"filterDishes('Pizza')\">Pizza</button>\n                <button class=\"filter-btn\" onclick=\"filterDishes('Biryani')\">Biryani</button>\n                <button class=\"filter-btn\" onclick=\"filterDishes('Fast Food')\">Fast Food</button>\n                <button class=\"filter-btn\" onclick=\"filterDishes('Desserts')\">Desserts</button>\n            </div>\n\n            <div class=\"dishes-grid\" id=\"dishesGrid\">\n                <!-- Populated by JS -->\n            </div>\n            <div id=\"emptyState\" class=\"empty-state\" style=\"display:none;\">\n                <i class=\"fa-solid fa-face-frown\"></i>\n                <h3>No dishes found</h3>\n                <p>Try searching for something else</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Special Offers -->\n    <section class=\"offers\" id=\"offers\">\n        <div class=\"container\">\n            <div class=\"offers-grid\">\n                <div class=\"offer-card offer-1\">\n                    <div class=\"offer-content\">\n                        <span class=\"offer-badge\">New User</span>\n                        <h2>Get 30% OFF</h2>\n                        <p>Your first order with FoodMania</p>\n                        <button class=\"offer-btn\" onclick=\"scrollToSection('categories')\">Order Now</button>\n                    </div>\n                    <div class=\"offer-image\">\n                        <i class=\"fa-solid fa-burger\"></i>\n                    </div>\n                </div>\n                <div class=\"offer-card offer-2\">\n                    <div class=\"offer-content\">\n                        <span class=\"offer-badge\">Limited Time</span>\n                        <h2>Buy 1 Get 1 Free</h2>\n                        <p>On selected pizzas this weekend</p>\n                        <button class=\"offer-btn\" onclick=\"scrollToSection('dishes')\">Grab Deal</button>\n                    </div>\n                    <div class=\"offer-image\">\n                        <i class=\"fa-solid fa-pizza-slice\"></i>\n                    </div>\n                </div>\n                <div class=\"offer-card offer-3 wide\">\n                    <div class=\"offer-content\">\n                        <span class=\"offer-badge\">Everyday</span>\n                        <h2>Free Delivery</h2>\n                        <p>On orders above Rs. 999 from selected restaurants</p>\n                        <button class=\"offer-btn\" onclick=\"scrollToSection('explore')\">Explore</button>\n                    </div>\n                    <div class=\"offer-image\">\n                        <i class=\"fa-solid fa-truck-fast\"></i>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- How It Works -->\n    <section class=\"how-it-works\">\n        <div class=\"container\">\n            <div class=\"section-header\" style=\"text-align:center;\">\n                <h2>How It Works</h2>\n                <p>Ordering food has never been easier</p>\n            </div>\n            <div class=\"steps\">\n                <div class=\"step\">\n                    <div class=\"step-number">1</div>\n                    <div class=\"step-icon\">🔍</div>\n                    <h3>Discover</h3>\n                    <p>Find your favorite restaurants and dishes nearby</p>\n                </div>\n                <div class=\"step\">\n                    <div class=\"step-number\">2</div>\n                    <div class=\"step-icon\">🛒</div>\n                    <h3>Order</h3>\n                    <p>Add delicious food to your cart and checkout</p>\n                </div>\n                <div class=\"step\">\n                    <div class=\"step-number\">3</div>\n                    <div class=\"step-icon\">🚚</div>\n                    <h3>Enjoy</h3>\n                    <p>Get your food delivered to your doorstep</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Customer Reviews -->\n    <section class=\"reviews\">\n        <div class=\"container\">\n            <div class=\"section-header\" style=\"text-align:center;\">\n                <h2>Customer Reviews</h2>\n                <p>What our food lovers say</p>\n            </div>\n            <div class=\"reviews-grid\" id=\"reviewsGrid\">\n                <!-- Populated by JS -->\n            </div>\n        </div>\n    </section>\n\n    <!-- About Us -->\n    <section class=\"about\" id=\"about\">\n        <div class=\"container about-content\">\n            <div class=\"about-text\">\n                <h2>Why Choose FoodMania?</h2>\n                <p>FoodMania is Pakistan's fastest-growing food delivery platform, bringing you the best meals from the best restaurants in your city. With thousands of restaurants, real-time tracking, and secure payment options, we make food delivery simple, fast, and delicious.</p>\n                <ul class=\"about-features\">\n                    <li><i class=\"fa-solid fa-check\"></i> 30-Minute Delivery Guarantee</li>\n                    <li><i class=\"fa-solid fa-check\"></i> 1000+ Restaurant Partners</li>\n                    <li><i class=\"fa-solid fa-check\"></i> Secure Online Payments</li>\n                    <li><i class=\"fa-solid fa-check\"></i> 24/7 Customer Support</li>\n                </ul>\n            </div>\n            <div class=\"about-visual\">\n                <div class=\"about-card\">\n                    <img src=\"https://images.unsplash.com/photo-1559339352-11d035aa65de?w=400&h=400&fit=crop\" alt=\"Food\">\n                    <div class=\"about-card-overlay\">\n                        <h3>4.9★ Average Rating</h3>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-grid\">\n                <div class=\"footer-brand\">\n                    <div class=\"footer-logo\">\n                        <div class=\"logo-icon\">FM</div>\n                        <span>FoodMania</span>\n                    </div>\n                    <p>Better than Foodhub. Premium food delivery, straight to your doorstep.</p>\n                    <div class=\"social-links\">\n                        <a href=\"#\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                        <a href=\"#\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                        <a href=\"#\"><i class=\"fa-brands fa-instagram\"></i></a>\n                        <a href=\"#\"><i class=\"fa-brands fa-tiktok\"></i></a>\n                    </div>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Quick Links</h4>\n                    <ul>\n                        <li><a href=\"#home\">Home</a></li>\n                        <li><a href=\"#explore\">Restaurants</a></li>\n                        <li><a href=\"#categories\">Categories</a></li>\n                        <li><a href=\"#offers\">Offers</a></li>\n                        <li><a href=\"#about\">About Us</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Cuisines</h4>\n                    <ul>\n                        <li><a href=\"#\">Burgers</a></li>\n                        <li><a href=\"#\">Pizza</a></li>\n                        <li><a href=\"#\">Biryani</a></li>\n                        <li><a href=\"#\">Chinese</a></li>\n                        <li><a href=\"#\">BBQ</a></li>\n                        <li><a href=\"#\">Desserts</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-contact\">\n                    <h4>Contact Us</h4>\n                    <ul>\n                        <li><i class=\"fa-solid fa-phone\"></i> +92 300 1234567</li>\n                        <li><i class=\"fa-solid fa-envelope\"></i> support@foodmania.com</li>\n                        <li><i class=\"fa-solid fa-location-dot\"></i> Karachi, Pakistan</li>\n                    </ul>\n                    <div class=\"newsletter\">\n                        <h4>Newsletter</h4>\n                        <form id=\"newsletterForm\">\n                            <input type=\"email\" placeholder=\"Enter your email\" required>\n                            <button type=\"submit\">Subscribe</button>\n                        </form>\n                    </div>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 FoodMania. All rights reserved. Better than Foodhub.</p>\n            </div>\n        </div>\n    </footer>\n\n    <!-- Auth Modal -->\n    <div class=\"auth-modal\" id=\"authModal\">\n        <div class=\"auth-modal-content\">\n            <button class=\"auth-close\" onclick=\"closeAuthModal()\">&times;</button>\n            <div class=\"auth-tabs\">\n                <button class=\"auth-tab active\" onclick=\"switchAuthTab('login')\">Login</button>\n                <button class=\"auth-tab\" onclick=\"switchAuthTab('signup')\">Sign Up</button>\n            </div>\n            <form id=\"loginForm\" class=\"auth-form\">\n                <h3>Welcome Back</h3>\n                <div class=\"form-group\">\n                    <label>Email</label>\n                    <input type=\"email\" placeholder=\"Enter your email\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label>Password</label>\n                    <input type=\"password\" placeholder=\"Enter your password\" required>\n                </div>\n                <button type=\"submit\" class=\"btn-primary auth-btn\">Login</button>\n                <p class=\"auth-footer\">Don't have an account? <span onclick=\"switchAuthTab('signup')\">Sign Up</span></p>\n            </form>\n            <form id=\"signupForm\" class=\"auth-form\" style=\"display:none;\">\n                <h3>Create Account</h3>\n                <div class=\"form-group\">\n                    <label>Full Name</label>\n                    <input type=\"text\" placeholder=\"Enter your name\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label>Email</label>\n                    <input type=\"email\" placeholder=\"Enter your email\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label>Phone</label>\n                    <input type=\"tel\" placeholder=\"Enter your phone number\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label>Password</label>\n                    <input type=\"password\" placeholder=\"Create a password\" required>\n                </div>\n                <button type=\"submit\" class=\"btn-primary auth-btn\">Create Account</button>\n                <p class=\"auth-footer\">Already have an account? <span onclick=\"switchAuthTab('login')\">Login</span></p>\n            </form>\n        </div>\n    </div>\n\n    <!-- Cart Sidebar -->\n    <div class=\"cart-sidebar\" id=\"cartSidebar\">\n        <div class=\"cart-header\">\n            <h2>Your Cart</h2>\n            <button class=\"cart-close\" onclick=\"toggleCart()\">&times;</button>\n        </div>\n        <div class=\"cart-items\" id=\"cartItems\">\n            <!-- Populated by JS -->\n        </div>\n        <div class=\"cart-footer\">\n            <div class=\"cart-summary\">\n                <div class=\"summary-row\">\n                    <span>Subtotal</span>\n                    <span id=\"cartSubtotal\">Rs. 0</span>\n                </div>\n                <div class=\"summary-row\">\n                    <span>Delivery Fee</span>\n                    <span id=\"cartDelivery\">Rs. 100</span>\n                </div>\n                <div class=\"summary-row total\">\n                    <span>Total</span>\n                    <span id=\"cartTotal\">Rs. 100</span>\n                </div>\n            </div>\n            <button class=\"btn-primary cart-checkout\" id=\"cartCheckoutBtn\" onclick=\"openCheckout()\">Proceed to Checkout</button>\n        </div>\n    </div>\n\n    <!-- Checkout Modal -->\n    <div class=\"checkout-modal\" id=\"checkoutModal\">\n        <div class=\"checkout-content\">\n            <button class=\"checkout-close\" onclick=\"closeCheckout()\">&times;</button>\n            <h2>Checkout</h2>\n            <form id=\"checkoutForm\">\n                <div class=\"checkout-section\">\n                    <h3>Delivery Details</h3>\n                    <div class=\"form-group\">\n                        <label>Full Name</label>\n                        <input type=\"text\" id=\"checkoutName\" placeholder=\"John Doe\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label>Phone Number</label>\n                        <input type=\"tel\" id=\"checkoutPhone\" placeholder=\"+92 300 0000000\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label>Delivery Address</label>\n                        <textarea id=\"checkoutAddress\" placeholder=\"House, Street, Area, City\" rows=\"3\" required></textarea>\n                    </div>\n                </div>\n                <div class=\"checkout-section\">\n                    <h3>Order Summary</h3>\n                    <div class=\"order-items\" id=\"checkoutItems\"></div>\n                    <div class=\"summary-row\">\n                        <span>Subtotal</span>\n                        <span id=\"checkoutSubtotal\">Rs. 0</span>\n                    </div>\n                    <div class=\"summary-row\">\n                        <span>Delivery Fee</span>\n                        <span>Rs. 100</span>\n                    </div>\n                    <div class=\"summary-row total\">\n                        <span>Total</span>\n                        <span id=\"checkoutTotal\">Rs. 100</span>\n                    </div>\n                </div>\n                <div class=\"checkout-section\">\n                    <h3>Payment Method</h3>\n                    <div class=\"payment-options\">\n                        <label class=\"payment-option\">\n                            <input type=\"radio\" name=\"payment\" value=\"cod\" checked>\n                            <div class=\"payment-check\"></div>\n                            <span>Cash on Delivery</span>\n                        </label>\n                        <label class=\"payment-option\">\n                            <input type=\"radio\" name=\"payment\" value=\"easypaisa\">\n                            <div class=\"payment-check\"></div>\n                            <span>Easypaisa</span>\n                        </label>\n                        <label class=\"payment-option\">\n                            <input type=\"radio\" name=\"payment\" value=\"jazzcash\">\n                            <div class=\"payment-check\"></div>\n                            <span>JazzCash</span>\n                        </label>\n                    </div>\n                    <div class=\"demo-notice\">\n                        <small><i class=\"fa-solid fa-info-circle\"></i> Demo mode: Orders are simulated. No real payment is processed.</small>\n                    </div>\n                </div>\n                <button type=\"submit\" class=\"btn-primary checkout-btn\">Place Order - Rs. <span id=\"checkoutFinalTotal\">0</span></button>\n            </form>\n        </div>\n    </div>\n\n    <!-- Order Success Modal -->\n    <div class=\"success-modal\" id=\"successModal\">\n        <div class=\"success-content\">\n            <i class=\"fa-solid fa-circle-check success-icon\"></i>\n            <h2>Order Placed!</h2>\n            <p>Thank you for ordering with FoodMania. Your food is on the way!</p>\n            <div class=\"success-order-id\">Order #FM<span id=\"successOrderId\"></span></div>\n            <button class=\"btn-primary\" onclick=\"closeSuccess()\">Track Order</button>\n            <button class=\"btn-outline\" onclick=\"closeSuccess()\">Continue Shopping</button>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>"}

