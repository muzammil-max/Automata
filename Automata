#!/bin/sh
# Automata — desktop launcher (native Rust UI).
#
# The Rust UI starts what it needs by itself:
#   1. the C++ backend (api_server) on port 8080, if it is not running
#   2. the fast browser engine (automata-browser) on port 9515
#   3. the Automata window
#
# Chrome is found automatically by the backend. You can still point it at a
# specific browser:
#   CHROME_PATH=/path/to/chrome ./Automata

APP_DIR="/home/muzammil/Desktop/automata2"
UI_BIN="$APP_DIR/rust/target/release/automata-ui"

mkdir -p /tmp/opencode

if [ ! -x "$UI_BIN" ]; then
    echo "Automata: the UI binary is missing. Build it with:"
    echo "  cd $APP_DIR/rust && cargo build --release"
    exit 1
fi

# Tell the backend where the frontend files are (it serves them on port 8080).
export AUTOMATA_FRONTEND_DIR="$APP_DIR/frontend"
export CHROMEDRIVER_URL="http://127.0.0.1:9515"

cd "$APP_DIR"
exec "$UI_BIN"
