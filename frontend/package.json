{
  "name": "automata-frontend",
  "version": "1.0.0",
  "productName": "Automata",
  "description": "Automata desktop UI (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win --x64 --dir --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "license": "MIT",
  "author": "Automata",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.automata.desktop",
    "productName": "Automata",
    "asar": false,
    "directories": {
      "output": "../build/windows/dist",
      "buildResources": "../build/windows/resources"
    },
    "files": [
      "**/*",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../build/windows/artifacts/backend",
        "to": "backend"
      },
      {
        "from": "../build/windows/artifacts/driver",
        "to": "driver"
      }
    ],
    "win": {
      "icon": "../build/windows/resources/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Automata-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "Automata-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Automata",
      "runAfterFinish": true
    }
  }
}
